# Copy to .env and fill in values. Model choice is controlled only here (and your real .env).

# Optional — defaults match local Postgres (see README)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docqa

OPENAI_API_KEY=

# Chat completion model (e.g. gpt-4o-mini, gpt-4o, gpt-5-mini — use IDs from OpenAI docs for your account)
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embedding model — must match OPENAI_EMBEDDING_DIMENSIONS for that model (e.g. text-embedding-3-small with 1536)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
